# AI Pattern & Image Design Studio PRO — Environment Configuration Template
# Copy this file to .env and configure your external API keys if connecting to cloud AI providers.
# NOTE: Never commit your private API keys to version control.

# AI Provider Configuration
# Supported providers: gemini, openai, stability, replicate, custom
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your_gemini_api_key_here
AI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/

# Optional External Generation Parameters
AI_IMAGE_DIMENSIONS=1024x1024
AI_MAX_VARIATIONS=4

# Studio SaaS Environment
APP_ENV=development
APP_DEFAULT_LOCALE=en
APP_DEFAULT_THEME=dark
APP_DEFAULT_ACCENT=indigo
APP_FREE_CREDITS_PER_MONTH=100
